# Consortho Environment Variables
# Copia este arquivo para .env e preenche os valores
# cp .env.example .env

# ============================================================
# SERVER CONFIG
# ============================================================
NODE_ENV=production
PORT=9877
TZ=America/Sao_Paulo

# ============================================================
# TELEGRAM BOT (obrigatório para notificações)
# ============================================================
# 1. Fala com @BotFather no Telegram
# 2. /newbot → escolhe nome → pega o token
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui
# Como pegar chat_id: manda msg pro bot → abre https://api.telegram.org/bot<TOKEN>/getUpdates

# ============================================================
# GRAFANA (dashboard monitoring)
# ============================================================
GRAFANA_PASSWORD=senha_forte_aqui
GRAFANA_USER=admin

# ============================================================
# DOMÍNIO/SSL (para HTTPS automático via Let's Encrypt)
# ============================================================
# Deixa vazio se não tiver domínio ainda
DOMAIN=seu-dominio.com
EMAIL_SSL=seu-email@exemplo.com

# ============================================================
# DATABASE/REDIS (opcional - deixa vazio para usar arquivos locais)
# ============================================================
REDIS_URL=
DATABASE_URL=

# ============================================================
# EXTERNAL APIs (opcional)
# ============================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=