// store/useStore.ts
import { create } from 'zustand';
import { persist } from 'zustand/middleware';

interface State {
  stats: any;
  lumin: any;
  diamond: any;
  settings: {
    apiBase: string;
    notifications: boolean;
    theme: 'dark' | 'light';
  };
  actions: {
    setStats: (stats: any) => void;
    setLumin: (lumin: any) => void;
    setDiamond: (diamond: any) => void;
    updateSettings: (settings: Partial<State['settings']>) => void;
  };
}

export const useStore = create<State>()(
  persist(
    (set) => ({
      stats: null,
      lumin: null,
      diamond: null,
      settings: {
        apiBase: 'http://127.0.0.1:9877',
        notifications: true,
        theme: 'dark',
      },
      actions: {
        setStats: (stats) => set({ stats }),
        setLumin: (lumin) => set({ lumin }),
        setDiamond: (diamond) => set({ diamond }),
        updateSettings: (settings) => set((state) => ({ settings: { ...state.settings, ...settings } })),
      },
    }),
    { name: 'consortho-storage' }
  );
}

// providers/Providers.tsx
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ReactQueryDevtools } from '@tanstack/react-query-devtools';
import { StoreProvider } from '@/store/useStore';

export function Providers({ children }) {
  const [queryClient] = useState(() => new QueryClient({
    defaultOptions: {
      queries: {
        staleTime: 5000,
        refetchOnWindowFocus: false,
        retry: 1,
      },
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <StoreProvider>
        {children}
        {__DEV__ && <ReactQueryDevtools initialIsOpen={false} />}
      </StoreProvider>
    </QueryClientProvider>
  );
}

// app/lumin.tsx
import React, { useEffect, useState } from 'react';
import { View, Text, ScrollView, TouchableOpacity, StyleSheet, Animated, Easing, Image, Dimensions } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { Ionicons, MaterialIcons } from '@expo/vector-icons';
import { useRouter } from 'expo-router';
import { useStore } from '@/store/useStore';
import { api } from '@/services/api';

const { width } = Dimensions.get('window');

export default function LuminScreen() {
  const router = useRouter();
  const { state, actions } = useStore();
  const [lumin, setLumin] = useState(null);
  const [forms, setForms] = useState([]);
  const [activeTab, setActiveTab] = useState('evolution');

  useEffect(() => {
    fetchLumin();
    const interval = setInterval(fetchLumin, 10000);
    return () => clearInterval(interval);
  }, []);

  const fetchLumin = async () => {
    try {
      const [luminData, formsData] = await Promise.all([
        api.get('/api/lumin/state'),
        api.get('/api/diamond/evolution'),
      ]);
      setLumin(luminData.data);
      setForms(formsData.data?.forms || []);
    } catch (e) {
      console.error('Erro ao buscar Lumin:', e);
    }
  };

  const triggerEvolution = async () => {
    try {
      await fetch('http://127.0.0.1:9877/api/lumin/evolucao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ forma: 'auto', ki: 5000, nivel: 1 }),
      });
    } catch (e) {}
  };

  const triggerSandevistan = async (level) => {
    try {
      await fetch('http://127.0.0.1:9877/api/lumin/sandevistan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ acao: 'ativar', nivel: 3 }),
      });
    } catch (e) {}
  };

  const triggerFusion = async (type) => {
    try {
      await fetch('http://127.0.0.1:9877/api/lumin/fusao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fusao: type }),
      });
    } catch (e) {}
  };

  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.content}>
      {/* Header */}
      <View style={styles.header}>
        <LinearGradient colors={['#ff33aa', '#ff6b35', '#ffcc00']} style={styles.headerGradient}>
          <View style={styles.headerContent}>
            <Text style={styles.title}>💫 LUMIN EVOLUTION</Text>
            <Text style={styles.subtitle}>Evolução • Sandevistan • Fusões</Text>
          </View>
        </LinearGradient>
      </View>

      {/* Tabs */}
      <View style={styles.tabs}>
        {['evolution', 'sandevistan', 'fusion', 'forms'].map((tab) => (
          <TouchableOpacity
            key={tab}
            style={[{ flex: 1, paddingVertical: 12, alignItems: 'center', borderBottomWidth: 2, borderBottomColor: activeTab === tab ? '#ff33aa' : 'transparent' }, styles.tab]}
            onPress={() => setActiveTab(tab)}
          >
            <Text style={[styles.tabLabel, activeTab === tab ? styles.activeTabLabel : styles.inactiveTabLabel]}>
              {tab === 'evolution' && '⚡ Evolução'}
              {tab === 'sandevistan' && '⚡⚡⚡ Sandevistan'}
              {tab === 'fusion' && '🌟 Fusões'}
              {tab === 'forms' && '🔓 Formas'}
            </Text>
          </TouchableOpacity>
        )}
      </View>

      {/* Content */}
      <ScrollView style={{ flex: 1 }} contentContainerStyle={{ padding: 16 }}>
        {activeTab === 'evolution' && <EvolutionTab />}
        {activeTab === 'sandevistan' && <SandevistanTab />}
        {activeTab === 'fusion' && <FusionTab />}
        {activeTab === 'forms' && <FormsTab />}
      </View>
    </ScrollView>
  );
}

